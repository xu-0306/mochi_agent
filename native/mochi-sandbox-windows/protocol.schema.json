{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mochi.local/schemas/sandbox-broker-v1.json",
  "title": "Mochi sandbox broker JSON-lines frame",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "type", "nonce", "payload"],
  "properties": {
    "protocol_version": { "const": 1 },
    "type": { "enum": ["hello", "run", "cancel", "result", "error"] },
    "nonce": { "type": "string", "minLength": 16, "maxLength": 128 },
    "payload": { "type": "object", "maxProperties": 128 }
  }
}
